include LICENSE
include README.md
include CHANGELOG.md
include colabllm
recursive-include src/colabllm *.py *.ipynb *.html *.css *.js *.svg
recursive-include templates *.py *.ipynb *.js
recursive-include tests *.py
recursive-include tests_colab *.py
include tools/check_distribution.py
include tools/sync_runtime_docs.py
include tools/check_release.py
recursive-include docs *.md
global-exclude *.pyc
prune .state
prune .colabllm
recursive-include skills *.md
